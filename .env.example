# Copy thành .env (`make up` tự tạo nếu chưa có). Chỉ dùng cho môi trường dev local.
# docker-compose.yml có giá trị mặc định giống hệt file này, nên thiếu .env vẫn chạy được.
#
# LƯU Ý: thông tin đăng nhập Postgres chỉ có hiệu lực lúc volume được khởi tạo lần đầu.
# Đổi sau đó phải `make reset` (xoá volume) thì mới áp dụng.

# Postgres nguồn (OLTP) — dùng chung cho Postgres, Debezium và code ingestion
POSTGRES_DB=market_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Airflow metadata DB
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow

# Tài khoản đăng nhập Airflow UI (http://localhost:8088)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
